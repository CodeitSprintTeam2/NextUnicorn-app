# Local PostgreSQL 18 connection URL
# Replace `postgres`, `password`, and the database name with your local settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Docker Compose injects this value automatically inside the backend container:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/view_my_startup"

# Origin allowed to access the backend API (no trailing slash)
CLIENT_ORIGIN="http://localhost:5173"
